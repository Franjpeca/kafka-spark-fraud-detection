{
  "namespace": "fraud_detection.paysim",
  "type": "record",
  "name": "PaymentTransaction",
  "fields": [
    { "name": "step", "type": ["null", "int"], "default": null },
    { "name": "type", "type": "string" },
    { "name": "amount", "type": "double" },

    { "name": "nameorig", "type": ["null", "string"], "default": null },
    { "name": "namedest", "type": ["null", "string"], "default": null },

    { "name": "isfraud", "type": ["null", "int"], "default": null },
    { "name": "isflaggedfraud", "type": ["null", "int"], "default": null },

    { "name": "timestamp", "type": ["null", "long"], "default": null },

    { "name": "customer_id", "type": "string" },
    { "name": "source_system", "type": "string" },

    { "name": "transaction_datetime", "type": ["null", "string"], "default": null },

    { "name": "city", "type": "string" },
    { "name": "country", "type": "string" },
    { "name": "currency", "type": "string" },
    { "name": "channel", "type": "string" },

    { "name": "merchant", "type": ["null", "string"], "default": null },
    { "name": "status", "type": "string" }
  ]
}
